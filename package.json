{
  "name": "ai-commander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "tsx packages/core/src/cli.ts serve .",
    "chat": "tsx scripts/chat.ts",
    "dev:web": "pnpm --filter @aicommander/web dev",
    "ui-check": "tsx scripts/ui-check.ts",
    "gen:keymap": "tsx scripts/gen-keymap.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "ws": "^8.18.0",
    "@aicommander/protocol": "workspace:*",
    "tsx": "^4.19.2"
  }
}
