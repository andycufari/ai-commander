#!/usr/bin/env node
// Thin shim so the repo tree matches §1: the real CLI is packages/core/src/cli.ts.
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const here = dirname(fileURLToPath(import.meta.url));
const { runCli } = await import(join(here, "..", "packages", "core", "dist", "cli.js"));
runCli();
